ENV=local
DEBUG=true

# Google Cloud / Firebase
GCP_PROJECT_ID=seu-projeto
FIRESTORE_DATABASE=(default)

# Local: baixe a chave em Console > Contas de servico > Gerar nova chave
# Em Cloud Run deixe VAZIO — usa a service account do proprio servico.
# Prefer gcloud auth application-default login for local development.
# In Cloud Run, leave this empty so the service identity is used.
GOOGLE_APPLICATION_CREDENTIALS=

# Emuladores locais (opcional)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Origens liberadas no CORS, separadas por virgula
CORS_ORIGINS=http://localhost:3000

# Primeiro administrador: este e-mail entra como admin no primeiro login
BOOTSTRAP_ADMIN_EMAILS=seu-email@gmail.com

# Formulario publico
CADASTRO_PUBLICO_ATIVO=true
CADASTRO_PUBLICO_RATE_LIMIT=20
