# Configuracao do deploy. Copie para infra/deploy.env e preencha.
# infra/deploy.env NAO vai para o git.

# --- Projeto ---------------------------------------------------------------
# O mesmo projeto que o Firebase usa. Firebase e Google Cloud nao sao nuvens
# diferentes: inadmav e um projeto GCP com os produtos Firebase ligados.
PROJETO=inadmav
REGIAO=southamerica-east1

# A conta Google dona do projeto. O script confere que o gcloud esta logado
# nela antes de qualquer coisa — deploy com a conta errada falha tarde e com
# mensagem ruim.
CONTA=admavsedecomunicacao@gmail.com

# --- Servicos --------------------------------------------------------------
SERVICO_API=inadmav-api
SERVICO_WEB=inadmav-web

# --- Backend ---------------------------------------------------------------
# Quem entra como administrador no primeiro login. Sem isso ninguem
# consegue acessar o sistema depois do deploy.
BOOTSTRAP_ADMIN_EMAILS=admavsedecomunicacao@gmail.com

CADASTRO_PUBLICO_ATIVO=true
CADASTRO_PUBLICO_RATE_LIMIT=20

# --- Teto de custo -------------------------------------------------------
# Maximo de instancias do Cloud Run por servico. O padrao do Cloud Run e
# 100 — muito acima do que uma igreja usa, e sem teto um pico (ou abuso do
# formulario publico) vira conta. Deixe vazio para nao definir teto.
MAX_INSTANCIAS=5

# --- Frontend --------------------------------------------------------------
# As NEXT_PUBLIC_* sao embutidas no bundle no build — sao publicas por
# design, qualquer um le no HTML. Nao sao segredo; a tranca real e a regra
# deny-all do Firestore mais a checagem de papel na API.
#
# Se deixar em branco, o script le de frontend/.env.local.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
